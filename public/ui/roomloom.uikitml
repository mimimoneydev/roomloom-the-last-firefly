<style>
  .panel-root {
    flex-direction: column;
    width: 430px;
    background-color: rgba(9, 24, 22, 0.96);
    border-color: rgba(117, 255, 198, 0.28);
    border-width: 2px;
    border-radius: 28px;
  }
  .eyebrow {
    color: #76e5b2;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-top: 24px;
    margin-left: 28px;
    margin-right: 28px;
  }
  .title {
    color: #173c31;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.05;
    margin-top: 8px;
    margin-left: 28px;
    margin-right: 28px;
  }
  .story {
    color: #35594c;
    font-size: 16px;
    line-height: 1.35;
    margin-top: 12px;
    margin-left: 28px;
    margin-right: 28px;
  }
  .progress-card {
    flex-direction: column;
    background-color: rgba(25, 54, 46, 0.9);
    border-radius: 18px;
    margin-top: 18px;
    margin-left: 28px;
    margin-right: 28px;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 18px;
    padding-right: 18px;
  }
  .progress {
    color: #ffd778;
    font-size: 25px;
    font-weight: 700;
  }
  .hint {
    color: #e7f7ef;
    font-size: 14px;
    line-height: 1.3;
    margin-top: 6px;
  }
  .actions {
    flex-direction: row;
    gap: 10px;
    margin-top: 16px;
    margin-left: 28px;
    margin-right: 28px;
    margin-bottom: 24px;
  }
  .primary {
    flex-grow: 1;
  }
  .secondary {
    flex-grow: 0;
  }
</style>
<Panel id="RoomloomPanel" class="panel-root">
  <div class="eyebrow">ROOMLOOM / DAY 01</div>
  <div class="title">Wake the last garden.</div>
  <div id="StoryText" class="story">Your room is holding three lost lights. Look at one, then pinch to guide it home.</div>
  <div id="ProgressCard" class="progress-card">
    <div id="ProgressText" class="progress">3 lights are waiting</div>
    <div id="HintText" class="hint">Seated play. No controllers required. Hand rays work; gaze is enabled on supported devices.</div>
  </div>
  <div class="actions">
    <Button id="StartButton" class="primary">
      <ButtonLabel id="StartLabel">Begin the glow</ButtonLabel>
    </Button>
    <Button id="ContrastButton" class="secondary">
      <ButtonLabel id="ContrastLabel">High contrast</ButtonLabel>
    </Button>
  </div>
</Panel>
