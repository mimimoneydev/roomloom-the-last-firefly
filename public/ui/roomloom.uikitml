<style>
  .panel-root { flex-direction: column; width: 400px; border-radius: 22px; padding-top: 16px; padding-bottom: 16px; padding-left: 16px; padding-right: 16px; }
  .eyebrow { color: #255d49; font-size: 12px; font-weight: 700; }
  .title { color: #173c31; font-size: 26px; font-weight: 700; margin-top: 4px; }
  .story { color: #35594c; font-size: 15px; line-height: 1.2; margin-top: 8px; }
  .progress-card { flex-direction: column; background-color: #19362e; border-radius: 14px; padding-top: 12px; padding-bottom: 12px; padding-left: 12px; padding-right: 12px; margin-top: 10px; }
  .progress { color: #ffd778; font-size: 22px; font-weight: 700; }
  .hint { color: #e7f7ef; font-size: 14px; line-height: 1.2; margin-top: 6px; }
  .actions { flex-direction: row; gap: 8px; margin-top: 8px; }
  .primary { flex-grow: 1; }
  .small { color: #35594c; font-size: 12px; margin-top: 6px; }
</style>
<Panel id="RoomloomPanel" class="panel-root">
  <div id="SpeciesText" class="eyebrow">ROOMLOOM / ROOM SCAN REQUIRED</div>
  <div id="TitleText" class="title">Your room is the habitat.</div>
  <div id="StoryText" class="story">Roomloom reads your real table and walls to build the puzzle.</div>
  <div id="ProgressCard" class="progress-card">
    <div id="ProgressText" class="progress">Waiting for a real surface</div>
    <div id="HintText" class="hint">Hands only, seated. Look at a clear table, then hold a pinch.</div>
  </div>
  <div id="GardenText" class="story">Your sanctuary begins with one rescue.</div>
  <div id="CapabilityText" class="small">Checking room features...</div>
  <div id="RelayActions" class="actions">
    <Button id="RelayAButton"><ButtonLabel>Lantern A</ButtonLabel></Button>
    <Button id="RelayBButton"><ButtonLabel>Lantern B</ButtonLabel></Button>
    <Button id="UndoButton"><ButtonLabel>Undo move</ButtonLabel></Button>
  </div>
  <div id="RelayText" class="small">One lantern. Two places. Try a route; undo is free.</div>
  <div class="actions">
    <Button id="PlaceButton" class="primary"><ButtonLabel id="PlaceLabel">Place in room</ButtonLabel></Button>
    <Button id="PreviewButton"><ButtonLabel>Preview (no room)</ButtonLabel></Button>
  </div>
  <div id="PlacementText" class="small">A real surface is required. Looking for a clear table or wall.</div>
  <div class="actions">
    <Button id="StartButton" class="primary"><ButtonLabel id="StartLabel">Plant here</ButtonLabel></Button>
    <Button id="ContrastButton"><ButtonLabel id="ContrastLabel">High contrast</ButtonLabel></Button>
    <Button id="TutorialButton"><ButtonLabel id="TutorialLabel">Skip guide</ButtonLabel></Button>
    <Button id="PauseButton"><ButtonLabel id="PauseLabel">Pause</ButtonLabel></Button>
  </div>
  <div id="TestActions" class="actions">
    <Button id="TestButton"><ButtonLabel>Save test report</ButtonLabel></Button>
  </div>
  <div id="TestText" class="small"></div>
</Panel>
